# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
JWT_SECRET=<your_jwt_secret>
PORT=5000

# Gmail SMTP Configuration
# EMAIL_USER is the SENDER email address only.
# The App Password authenticates the sender — never share it.
EMAIL_USER=<your_gmail_address>
EMAIL_APP_PASSWORD=<your_gmail_app_password>
FRONTEND_URL=http://localhost:3000

# Speech-to-Text (STT) Whisper Transcription (Optional: Groq or OpenAI)
GROQ_API_KEY=<ygsk_SBVCX27h5OWnuRDXoIj5WGdyb3FYpGR8NyB3bGZZE1tJdNNNZGhdour_groq_api_key>
OPENAI_API_KEY=<your_openai_api_key>